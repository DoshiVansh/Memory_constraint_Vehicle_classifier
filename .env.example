# ─── DagsHub Cloud DVC Remote + MLflow Tracking ──────────────────────────────
# Create a free account at https://dagshub.com and create a repo.
# Get your token at: https://dagshub.com/user/settings/tokens
DAGSHUB_USERNAME=your-dagshub-username
DAGSHUB_REPO_NAME=your-repo-name
DAGSHUB_TOKEN=your-dagshub-token

# ─── DVC Remote (S3-compatible, uses DagsHub token as credentials) ────────────
# These are read by scripts/configure_dvc_remote.sh and GitHub Actions secrets.
DVC_ACCESS_KEY=${DAGSHUB_USERNAME}    # DagsHub username acts as access key
DVC_SECRET_KEY=${DAGSHUB_TOKEN}       # DagsHub token acts as secret key
DVC_BUCKET=vehicle-classifier-data    # Bucket name (DagsHub manages this automatically)

# ─── MLflow Tracking (Stage 3 — DagsHub hosted MLflow server) ────────────────
MLFLOW_TRACKING_URI=https://dagshub.com/${DAGSHUB_USERNAME}/${DAGSHUB_REPO_NAME}.mlflow
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USERNAME}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}

# ─── Legacy: Local RustFS (kept for reference, no longer the default) ─────────
# DVC_ENDPOINT_URL=http://127.0.0.1:9000
# DVC_BIND_ADDRESS=127.0.0.1
